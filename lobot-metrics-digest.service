# Oneshot service called by lobot-metrics-digest.timer to send the monthly digest.
# Install alongside lobot-metrics-digest.timer.

[Unit]
Description=Send monthly Lobot metrics digest email

[Service]
Type=oneshot
Environment=LOBOT_CLUSTER_DIR=/opt/Lobot
Environment=LOBOT_TOOLS_DIR=/opt/Lobot/tools
WorkingDirectory=/opt/Lobot/tools
ExecStart=/opt/Lobot/tools/lobot-metrics.sh send-digest
User=croot
StandardOutput=journal
StandardError=journal
