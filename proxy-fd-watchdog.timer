# Install:
#   sudo cp /opt/Lobot/tools/proxy-fd-watchdog.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now proxy-fd-watchdog.timer
#
# Checks the JupyterHub proxy pod's FD count / RSS every 2 hours and
# emails an alert if either crosses threshold (see proxy-fd-watchdog.sh).
# Persistent=true means a missed run (e.g. host was down) fires on next boot.

[Unit]
Description=JupyterHub proxy pod FD/memory leak watchdog

[Timer]
OnCalendar=*-*-* 00/2:00:00
Persistent=true

[Install]
WantedBy=timers.target
